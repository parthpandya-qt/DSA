
class Node:
    def __init__(self, val):
        self.data = val
        self.left = None
        self.right = None


from collections import deque
class Solution:
    def serialize(self, root):
        #code here
        res = [] 
        if root == None:
            return ""
        q = deque()
        q.append(root)
        while q:
            temp = q.popleft()
            if temp is None:
                res.append('None')
            else:
                res.append(temp.data)
                q.append(temp.left)
                q.append(temp.right)
            
        return res
                
        
        

    def deSerialize(self, arr):
        q = deque()
        root = Node(arr[0])
        q.append(root)
        i = 1
        while q:
            temp = q.popleft()
            if arr[i]!='None':
                temp.left = Node(int(arr[i]))
                q.append(temp.left)
            i+=1
            
            if arr[i]!='None':
                temp.right = Node(int(arr[i]))
                q.append(temp.right)
            i+=1
        return root